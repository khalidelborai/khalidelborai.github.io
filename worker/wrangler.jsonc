{
  "name": "borai-engagement",
  "main": "src/index.js",
  "compatibility_date": "2026-06-01",

  // Same-origin route so the site can fetch "/api/...". borai.dev must be an
  // active zone on your Cloudflare account (it is — the blog proxies through it).
  "routes": [
    { "pattern": "blog.borai.dev/api/*", "zone_name": "borai.dev" },
    { "pattern": "blog.borai.dev/stats", "zone_name": "borai.dev" }
  ],

  // Non-secret config. CF_API_TOKEN (Account Analytics: Read) stays a secret:
  // `wrangler secret put CF_API_TOKEN`.
  //   CF_ACCOUNT_ID       — for the Analytics Engine SQL API
  //   ACCESS_TEAM_DOMAIN  — your Zero Trust team name (the <x> in
  //                         https://<x>.cloudflareaccess.com), e.g. "borai"
  //   ACCESS_AUD          — the Access application's Audience (AUD) tag
  // /stats fails closed until ACCESS_TEAM_DOMAIN + ACCESS_AUD are set and the
  // Access application is configured for blog.borai.dev/stats.
  "vars": {
    "CF_ACCOUNT_ID": "0fb46a910cc68c57468ccffc325ed5b6",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": ""
  },

  // id filled in by `wrangler kv namespace create ENGAGEMENT`.
  "kv_namespaces": [
    { "binding": "ENGAGEMENT", "id": "25ccbbd4e84f47d1ab19feb2e837f789" }
  ],

  // Event stream (referrers, scroll depth, search queries). Query via the
  // Cloudflare GraphQL/SQL Analytics API or the dashboard.
  "analytics_engine_datasets": [
    { "binding": "AE", "dataset": "borai_events" }
  ],

  "observability": { "enabled": true }
}
